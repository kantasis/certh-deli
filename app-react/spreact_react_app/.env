PROJECT_NAME="deli"

NODE_PORT="5173"
HOST_NODE_PORT="9080"

SPRING_PORT="8080"
HOST_SPRING_PORT="8081"

# TODO: This is not in the grafana.env
HOST_GRAFANA_PORT="3000"

# Grafana global vars:
# GLOBAL_GF_PATHS_PROVISIONING="/etc/grafana/provisioning/"
GLOBAL_GF_PATHS_PROVISIONING="/home/grafana/provisioning"

# Postgres global vars
GLOBAL_POSTGRES_USER="postgres"
GLOBAL_POSTGRES_PASSWORD="postgres"
GLOBAL_PGPORT="5433"
GLOBAL_POSTGRES_DB="${PROJECT_NAME}_db"
GLOBAL_PGDATA="/data"
